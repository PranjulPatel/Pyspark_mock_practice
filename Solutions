def load_orders_data(spark:SparkSession,path:str)->DataFrame:
    df=spark.read.csv(path,header=True,inferSchema=True)
    df=df.withColumn("order_date",to_date(col("order_date")))
    return df

def filter_valid_orders(df:DataFrame)->DataFrame:
    df1=df.filter(col("order_id").isNotNull() & (col("quantity")>0))
    return df1

def add_order_amount(df:DataFrame)->DataFrame:
    df2=df.withColumn("order_amount",(col("quantity")*col("unit_price")))
    return df2

def revenue_by_category(df:DataFrame)->DataFrame:
    df3=df.groupBy("product_category").agg(sum("order_amount").alias("total_revenue")).orderBy(desc("total_revenue"))
    return df3

def filter_orders_by_status(df:DataFrame,status_value:str)->DataFrame:
    df4=df.filter(col("status")==status_value).select("order_id","status","city")
    return df4

def top_city_by_revenue(df:DataFrame)->Tuple[str,float]:
    df5=df.groupBy("city").agg(sum("order_amount").alias("total_amount")).orderBy(desc("total_amount"),asc("city")).first().collect()[0]
    return (df5["city"],df5["revenue"])


