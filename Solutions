def load_flight_data(spark:SparkSession,path:str)->DataFrame:
    df=spark.read.csv(path,header=True,inferSchema=True)
    df=df.withColumn("flight_date",to_date(col("flight_date")))
    return df

def filter_valid_flights(df:DataFrame)->DataFrame:
    df1=df.filter(col("flight_id").isNotNull() & (col("scheduled_minutes")>0))
    return df1

def add_delay_minutes(df:DataFrame)->DataFrame:
    df2=df.withColumn("delay_minutes",(col("actual_minutes")-col("scheduled_minutes")))
    return df2

def filter_delayed_flights(df:DataFrame,threshold:int)->DataFrame:
    df3=df.filter(col("delay_minutes")>threshold).select("flight_id","airline","delay_minutes")
    return df3

def avg_delay_by_airline(df:DataFrame)->DataFrame:
    df4=df.groupBy("airline").agg(avg("delay_minutes").alias("avg_delay"))
    return df4

def busiest_route(df:DataFrame)->Tuple[str,int]:
    df_with_route = df.withColumn("route", concat_ws("-", "origin", "destination"))
    df5 = (df_with_route.groupBy("route").agg(count("*").alias("flight_count")).orderBy(desc("flight_count")).first())
    return (df5["route"], df5["flight_count"])



