def load_sales(spark: SparkSession, path: str) -> DataFrame:
    """Enforces floating-point structural validation across coffee transaction entries via custom schema mapping[cite: 1099, 1106, 1116]."""
    schema = StructType([
        StructField("store_id", StringType(), True), # [cite: 1112, 1113]
        StructField("city", StringType(), True), # [cite: 1112, 1113]
        StructField("date", StringType(), True), # [cite: 1112, 1113]
        StructField("drink_type", StringType(), True), # [cite: 1112, 1113]
        StructField("quantity", IntegerType(), True), # [cite: 1112, 1113]
        StructField("revenue", DoubleType(), True) # [cite: 1112, 1113, 1116]
    ])
    return spark.read.option("header", "true").schema(schema).csv(path) # [cite: 1114]

def drop_bad_rows(df: DataFrame) -> DataFrame:
    """Eliminates record row instances lacking either primary date or explicit drink classifications[cite: 1120, 1126]."""
    return df.dropna(subset=["date", "drink_type"]) # [cite: 1128]

def daily_drink_metrics(df: DataFrame) -> DataFrame:
    """Aggregates metrics to evaluate product quantity and gross performance indicators daily[cite: 1129, 1135]."""
    return df.groupBy("date", "drink_type").agg(
        _sum("quantity").alias("qty"),
        _sum("revenue").alias("rev")
    ) # [cite: 1137]

def with_share(df: DataFrame) -> List[str]:
    """Evaluates proportional revenue contribution values sorting corresponding drink items descending[cite: 1143, 1149, 1150]."""
    rev_by_drink = df.groupBy("drink_type").agg(_sum("rev").alias("rev_by_drink")) # [cite: 1152]
    total_rev_val = rev_by_drink.select(_sum("rev_by_drink")).first()[0] # [cite: 1153]
    
    if not total_rev_val:
        return []
        
    share_df = rev_by_drink.withColumn("share", col("rev_by_drink") / lit(total_rev_val)) \
                           .orderBy(desc("share")) # [cite: 1154, 1155]
    
    collected_drinks = share_df.select("drink_type").collect()
    return [row["drink_type"] for row in collected_drinks] # [cite: 1156]



