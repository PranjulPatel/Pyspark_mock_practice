def create_claim_schema_and_load(spark:SparkSession,path:str)->DataFrame:
    schema=StructType([
        StructField("claim_id",StringType(),True),
        StructField("customer_id",StringType(),True),
        StructField("region",StringType(),True),
        StructField("claim_date",DateType(),True),
        StructField("claim_amount",DoubleType(),True),
        StructField("status",StringType(),True),
        StructField("promised_settlement",DateType(),True)
    ])
    df=spark.createDataFrame(path,schema=schema,header=True,inferSchema=True)
    return df

def handle_null_promised_settlement(df:DataFrame)->DataFrame:
    df1=df.withColumn("promised_settlement", coalesce(col("promised_settlement"), date_add(col("claim_date"), 30)))
    return df1

def filter_approved_claims_in_range(df:DataFrame,start_date:str,end_date:str)->DataFrame:
    df2=df.filter((col("status")=="approved") & (col("claim_date").between(start_date,end_date)))
    return df2


def top_region_by_total_claim(df:DataFrame)->DataFrame:
    df3=df.groupBy("region").agg(sum("claim_amount").alias("total_claim_amount")).orderBy(desc("total_claim_amount")).limit(1)
    return df3

def find_max_claim_holder(df:DataFrame)->DataFrame:
    df4=df.orderBy("claim_amount").limit(1)
    return df4


